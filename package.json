{
	"name": "obsidian-mindloom",
	"version": "1.0.0",
	"description": "Weave your notes into interactive mind maps, in a split view or embedded in your notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"mind-map",
		"mindmap",
		"mind-elixir"
	],
	"license": "0BSD",
	"author": "西山雨 <https://github.com/XiShanRain>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/XiShanRain/obsidian-mindloom.git"
	},
	"bugs": {
		"url": "https://github.com/XiShanRain/obsidian-mindloom/issues"
	},
	"homepage": "https://github.com/XiShanRain/obsidian-mindloom#readme",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/katex": "^0.16.8",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "0.3.0",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "~5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"@mind-elixir/export-mindmap": "^0.1.9",
		"@types/mdast": "^4.0.4",
		"katex": "^0.16.45",
		"mind-elixir": "6.0.0-next.4",
		"obsidian": "1.12.0",
		"rehype-stringify": "^10.0.1",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.1",
		"unified": "^11.0.0",
		"unist-util-visit": "^5.0.0"
	}
}
